# Copy this file to .env.local (already gitignored) and fill in real values.
# scripts/build_release.sh reads every one of these -- a missing var fails
# the build loudly instead of silently shipping with that feature off, which
# is exactly what happened when MICRO_LESSON_CDN_BASE_URL was left out of
# every manually-typed build command this session: 18 of 39 micro-lesson
# clips silently showed "video not yet available" with no error anywhere.

# Supabase project (Settings -> API -> Project URL).
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase's *publishable* key -- either the modern sb_publishable_...
# format, or a legacy anon-role JWT (Settings -> API). Never the
# sb_secret_.../service_role key -- that must never ship in a client build.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# The NestJS BFF (apps/api)'s deployed base URL, including /v1.
API_BASE_URL=https://your-deployment.vercel.app/v1

# Google Cloud Console -> Credentials -> the "Web application" OAuth
# client ID (not the Android one) -- used as google_sign_in's
# serverClientId. Optional: Google Sign-In is simply unavailable if unset.
GOOGLE_WEB_CLIENT_ID=

# Public base URL serving micro-lesson videos not bundled into the app
# (see assets/micro_lessons/warehouse_clips.json's cloudflareVideoPath
# field) -- e.g. a Cloudflare R2 bucket's Public Development URL or a
# custom domain in front of it. Optional: clips without a bundled local
# video fall back to "video not yet available" if unset, which is a silent
# feature-off, not a build error, so don't skip this by accident.
MICRO_LESSON_CDN_BASE_URL=
