{
  "id": "receive-incoming-shipment-01",
  "version": "1.0.0",
  "packId": "logistics-foundation",
  "workplaceId": "central-distribution-centre",
  "departmentId": "receiving",
  "processId": "incoming-shipment-receipt",
  "role": {
    "id": "warehouse-associate-trainee",
    "industry": "logistics_supply_chain",
    "title": "Warehouse Associate",
    "level": "trainee",
    "departmentIds": ["receiving"],
    "requiredCompetencies": [
      "document-verification",
      "inventory-accuracy",
      "goods-inspection",
      "warehouse-compliance",
      "receiving-decisions"
    ],
    "promotionTargetRoleId": "warehouse-associate-junior"
  },
  "title": "Receive an Incoming Shipment",
  "difficulty": "beginner",
  "estimatedDurationMinutes": 20,
  "missionType": "guided_shift",
  "briefing": {
    "supervisorTitle": "Receiving Supervisor",
    "message": "Good morning. Apex Consumer Products is delivering stock against purchase order PO-2026-001. Inspect the delivery carefully, record every discrepancy and prevent non-compliant goods from entering available inventory.",
    "shiftName": "Morning Shift",
    "supplier": "Apex Consumer Products",
    "purchaseOrderNumber": "PO-2026-001",
    "deliveryReference": "DN-2026-001",
    "deliveryType": "Scheduled supplier delivery",
    "responsibilities": [
      "Verify shipment documents",
      "Inspect incoming stock",
      "Identify discrepancies",
      "Separate problematic stock",
      "Complete the receiving discrepancy report",
      "Make the final receiving decision"
    ],
    "workplaceRules": [
      "Damaged goods cannot enter available inventory.",
      "Items not listed on the purchase order must not be accepted.",
      "Unreadable barcodes require hold or escalation.",
      "Quantity discrepancies must be recorded.",
      "Required inspections cannot be skipped."
    ],
    "rulesVersion": "1.0.0"
  },
  "objectives": [
    "Verify shipment documents",
    "Inspect received stock",
    "Identify discrepancies",
    "Separate problematic stock",
    "Make the correct receiving decision",
    "Complete a discrepancy report"
  ],
  "startingWorkstationId": "document-desk",
  "stages": [
    "mission-briefing",
    "document-verification",
    "receiving-count",
    "physical-inspection",
    "exception-handling",
    "receiving-decision",
    "shift-report"
  ],
  "stageDefinitions": [
    {
      "id": "mission-briefing",
      "missionId": "receive-incoming-shipment-01",
      "sequence": 1,
      "title": "Supervisor Briefing",
      "workstationId": "document-desk",
      "instructions": "Review the mission objectives and operating rules.",
      "taskIds": [],
      "completionMode": "all_mandatory_tasks"
    },
    {
      "id": "document-verification",
      "missionId": "receive-incoming-shipment-01",
      "sequence": 2,
      "title": "Verify Shipment Documents",
      "workstationId": "document-desk",
      "instructions": "Compare the purchase order with the delivery note.",
      "taskIds": ["open-purchase-order", "open-delivery-note", "record-document-finding", "verify-documents"],
      "completionMode": "all_mandatory_tasks"
    },
    {
      "id": "receiving-count",
      "missionId": "receive-incoming-shipment-01",
      "sequence": 3,
      "title": "Confirm Delivered Stock",
      "workstationId": "receiving-dock",
      "instructions": "Confirm the delivery identity and count every carton.",
      "taskIds": ["confirm-delivery-identity", "confirm-received-counts"],
      "completionMode": "all_mandatory_tasks"
    },
    {
      "id": "physical-inspection",
      "missionId": "receive-incoming-shipment-01",
      "sequence": 4,
      "title": "Inspect Delivered Stock",
      "workstationId": "inspection-zone",
      "instructions": "Count and inspect every carton without revealing hidden issues.",
      "taskIds": ["inspect-cartons", "scan-barcodes"],
      "completionMode": "all_mandatory_tasks"
    },
    {
      "id": "exception-handling",
      "missionId": "receive-incoming-shipment-01",
      "sequence": 5,
      "title": "Handle Exceptions",
      "workstationId": "quarantine-zone",
      "instructions": "Assign safe dispositions and separate problematic goods.",
      "taskIds": ["assign-dispositions", "confirm-quarantine"],
      "completionMode": "all_mandatory_tasks"
    },
    {
      "id": "receiving-decision",
      "missionId": "receive-incoming-shipment-01",
      "sequence": 6,
      "title": "Make the Receiving Decision",
      "workstationId": "receiving-office",
      "instructions": "Complete the discrepancy report before deciding.",
      "taskIds": ["complete-discrepancy-report", "make-receiving-decision"],
      "completionMode": "correct_decision"
    },
    {
      "id": "shift-report",
      "missionId": "receive-incoming-shipment-01",
      "sequence": 7,
      "title": "Complete Shift Report",
      "workstationId": "receiving-office",
      "instructions": "Notify the receiving supervisor with the audit trail.",
      "taskIds": ["notify-supervisor"],
      "completionMode": "all_mandatory_tasks"
    }
  ],
  "taskDefinitions": [
    {
      "id": "open-purchase-order",
      "stageId": "document-verification",
      "taskType": "read_document",
      "title": "Open Purchase Order",
      "instructions": "Read PO-2026-001.",
      "mandatory": true,
      "repeatable": false,
      "availableActions": ["open_resource"],
      "targetResourceIds": ["purchase-order-po-2026-001"],
      "competencyMappings": [{"competencyId": "document-verification", "weight": 1.0}],
      "maximumPoints": 5,
      "scoreCategoryId": "process-accuracy",
      "evaluationRules": [{
        "actionType": "open_resource",
        "targetId": "purchase-order-po-2026-001",
        "outcomeType": "correct",
        "pointsAwarded": 5,
        "feedbackCode": "purchase_order_reviewed",
        "correctActionLabel": "Reviewed the purchase order"
      }]
    },
    {
      "id": "open-delivery-note",
      "stageId": "document-verification",
      "taskType": "read_document",
      "title": "Open Delivery Note",
      "instructions": "Read DN-2026-001.",
      "mandatory": true,
      "repeatable": false,
      "availableActions": ["open_resource"],
      "targetResourceIds": ["delivery-note-dn-2026-001"],
      "competencyMappings": [{"competencyId": "document-verification", "weight": 1.0}],
      "maximumPoints": 5,
      "scoreCategoryId": "process-accuracy",
      "evaluationRules": [{
        "actionType": "open_resource",
        "targetId": "delivery-note-dn-2026-001",
        "outcomeType": "correct",
        "pointsAwarded": 5,
        "feedbackCode": "delivery_note_reviewed",
        "correctActionLabel": "Reviewed the delivery note"
      }]
    },
    {
      "id": "record-document-finding",
      "stageId": "document-verification",
      "taskType": "classify_issue",
      "title": "Classify Document Findings",
      "instructions": "Record each discrepancy found without answer reveal.",
      "mandatory": false,
      "repeatable": true,
      "availableActions": ["classify_issue", "document_finding_added", "document_finding_updated", "document_finding_removed"],
      "targetResourceIds": ["document-line-SKU-1001", "document-line-SKU-1002", "document-line-SKU-1003", "document-line-SKU-1004", "document-line-SKU-1094", "document-comparison-summary"],
      "competencyMappings": [
        {"competencyId": "document-verification", "weight": 0.7},
        {"competencyId": "inventory-accuracy", "weight": 0.3}
      ],
      "maximumPoints": 20,
      "scoreCategoryId": "document-verification",
      "evaluationRules": [
        {"actionType": "classify_issue", "targetId": "document-line-SKU-1002", "requiredPayload": {"findingType": "quantityMismatch"}, "outcomeType": "correct", "pointsAwarded": 10, "feedbackCode": "quantity_mismatch_identified", "correctActionLabel": "Recorded the quantity mismatch", "missedIssueCode": "quantity_shortage"},
        {"actionType": "classify_issue", "targetId": "document-line-SKU-1094", "requiredPayload": {"findingType": "unexpectedItem"}, "outcomeType": "correct", "pointsAwarded": 10, "feedbackCode": "unexpected_sku_identified", "correctActionLabel": "Recorded the unexpected SKU", "missedIssueCode": "incorrect_sku"}
      ]
    },
    {
      "id": "verify-documents",
      "stageId": "document-verification",
      "taskType": "document_comparison",
      "title": "Record Document Discrepancies",
      "instructions": "Identify the shortage and unauthorised SKU.",
      "mandatory": true,
      "repeatable": true,
      "completeOnValidAction": true,
      "availableActions": ["complete_form"],
      "targetResourceIds": ["document-comparison-summary"],
      "competencyMappings": [
        {"competencyId": "document-verification", "weight": 0.7},
        {"competencyId": "inventory-accuracy", "weight": 0.3}
      ],
      "maximumPoints": 0,
      "scoreCategoryId": "document-verification",
      "evaluationRules": [{
        "actionType": "complete_form",
        "requiredPayload": {"submitted": true},
        "outcomeType": "correct",
        "pointsAwarded": 0,
        "feedbackCode": "document_findings_submitted",
        "correctActionLabel": "Submitted the document comparison"
      }]
    },
    {
      "id": "confirm-delivery-identity",
      "stageId": "receiving-count",
      "taskType": "confirm_action",
      "title": "Confirm Delivery Identity",
      "instructions": "Confirm whether the physical delivery matches the expected supplier and references.",
      "mandatory": true,
      "repeatable": true,
      "completeOnValidAction": true,
      "availableActions": ["confirm_action", "shipment_identity_confirmed"],
      "targetResourceIds": ["delivery-note-dn-2026-001"],
      "competencyMappings": [{"competencyId": "inventory-accuracy", "weight": 1.0}],
      "maximumPoints": 0,
      "scoreCategoryId": "inventory-accuracy",
      "evaluationRules": [{
        "actionType": "confirm_action",
        "requiredPayload": {"conclusion": "matchesExpectedDelivery"},
        "outcomeType": "correct",
        "pointsAwarded": 0,
        "feedbackCode": "delivery_identity_confirmed",
        "correctActionLabel": "Confirmed the expected delivery"
      }]
    },
    {
      "id": "confirm-received-counts",
      "stageId": "receiving-count",
      "taskType": "count_quantity",
      "title": "Confirm Received Counts",
      "instructions": "Record the two-unit shortage accurately.",
      "mandatory": true,
      "repeatable": true,
      "completeOnValidAction": true,
      "availableActions": ["count_quantity", "carton_count_recorded", "carton_count_updated", "carton_count_removed", "count_method_selected"],
      "targetResourceIds": ["carton-001", "carton-002", "carton-003", "carton-004", "carton-005", "carton-006"],
      "competencyMappings": [{"competencyId": "inventory-accuracy", "weight": 1.0}],
      "maximumPoints": 20,
      "scoreCategoryId": "inventory-accuracy",
      "evaluationRules": [
        {
          "actionType": "count_quantity",
          "requiredPayload": {"countMethod": "individual"},
          "payloadMatchesTargetContent": {"physicalQuantity": "quantity"},
          "outcomeType": "correct",
          "pointsAwarded": 4,
          "feedbackCode": "carton_count_verified",
          "correctActionLabel": "Individually counted the carton"
        },
        {
          "actionType": "count_quantity",
          "requiredPayload": {"countMethod": "sealedCarton"},
          "payloadMatchesTargetContent": {"physicalQuantity": "quantity"},
          "outcomeType": "partially_correct",
          "pointsAwarded": 2,
          "feedbackCode": "carton_label_count_recorded",
          "correctActionLabel": "Recorded the sealed-carton label count"
        }
      ]
    },
    {
      "id": "inspect-cartons",
      "stageId": "physical-inspection",
      "taskType": "inspect_item",
      "title": "Inspect Every Carton",
      "instructions": "Record the visible condition or confirm compliance.",
      "mandatory": true,
      "repeatable": true,
      "availableActions": ["inspect_item", "record_issue"],
      "targetResourceIds": ["carton-001", "carton-002", "carton-003", "carton-004", "carton-005", "carton-006"],
      "competencyMappings": [{"competencyId": "goods-inspection", "weight": 1.0}],
      "maximumPoints": 24,
      "scoreCategoryId": "quality-inspection",
      "evaluationRules": [
        {"actionType": "record_issue", "requiredPayload": {"issueType": "packaging_damage"}, "targetHasIssue": "packaging_damage", "outcomeType": "correct", "pointsAwarded": 4, "feedbackCode": "damage_identified", "correctActionLabel": "Identified damaged stock", "missedIssueCode": "packaging_damage"},
        {"actionType": "record_issue", "requiredPayload": {"issueType": "near_expiry"}, "targetHasIssue": "near_expiry", "outcomeType": "correct", "pointsAwarded": 4, "feedbackCode": "near_expiry_identified", "correctActionLabel": "Flagged near-expiry stock", "missedIssueCode": "near_expiry"},
        {"actionType": "record_issue", "requiredPayload": {"issueType": "incorrect_sku"}, "targetHasIssue": "incorrect_sku", "outcomeType": "correct", "pointsAwarded": 4, "feedbackCode": "incorrect_sku_identified", "correctActionLabel": "Identified the unauthorised SKU", "missedIssueCode": "incorrect_sku"},
        {"actionType": "record_issue", "requiredPayload": {"issueType": "quantity_shortage"}, "targetHasIssue": "quantity_shortage", "outcomeType": "correct", "pointsAwarded": 4, "feedbackCode": "carton_shortage_identified", "correctActionLabel": "Confirmed the physical shortage", "missedIssueCode": "quantity_shortage"},
        {"actionType": "record_issue", "requiredPayload": {"issueType": "unreadable_barcode"}, "targetHasIssue": "unreadable_barcode", "outcomeType": "correct", "pointsAwarded": 4, "feedbackCode": "barcode_issue_observed", "correctActionLabel": "Observed the unreadable barcode", "missedIssueCode": "unreadable_barcode"},
        {"actionType": "inspect_item", "requiredPayload": {"finding": "compliant"}, "targetMustBeCompliant": true, "outcomeType": "correct", "pointsAwarded": 4, "feedbackCode": "compliant_carton_confirmed", "correctActionLabel": "Confirmed compliant stock"}
      ]
    },
    {
      "id": "scan-barcodes",
      "stageId": "physical-inspection",
      "taskType": "scan_barcode",
      "title": "Scan Every Barcode",
      "instructions": "Record readable and unreadable barcode states.",
      "mandatory": true,
      "repeatable": true,
      "availableActions": ["scan_barcode"],
      "targetResourceIds": ["carton-001", "carton-002", "carton-003", "carton-004", "carton-005", "carton-006"],
      "competencyMappings": [
        {"competencyId": "goods-inspection", "weight": 0.5},
        {"competencyId": "warehouse-compliance", "weight": 0.5}
      ],
      "maximumPoints": 12,
      "scoreCategoryId": "safety-compliance",
      "evaluationRules": [
        {"actionType": "scan_barcode", "requiredPayload": {"barcodeStatus": "unreadable"}, "targetHasIssue": "unreadable_barcode", "outcomeType": "correct", "pointsAwarded": 2, "feedbackCode": "unreadable_barcode_detected", "correctActionLabel": "Detected the unreadable barcode", "missedIssueCode": "unreadable_barcode"},
        {"actionType": "scan_barcode", "requiredPayload": {"barcodeStatus": "readable"}, "targetLacksIssue": "unreadable_barcode", "outcomeType": "correct", "pointsAwarded": 2, "feedbackCode": "readable_barcode_confirmed"}
      ]
    },
    {
      "id": "assign-dispositions",
      "stageId": "exception-handling",
      "taskType": "select_disposition",
      "title": "Assign Item Dispositions",
      "instructions": "Keep problematic stock out of available inventory.",
      "mandatory": true,
      "repeatable": true,
      "availableActions": ["select_disposition"],
      "targetResourceIds": ["carton-001", "carton-002", "carton-003", "carton-004", "carton-005", "carton-006"],
      "competencyMappings": [
        {"competencyId": "warehouse-compliance", "weight": 0.6},
        {"competencyId": "receiving-decisions", "weight": 0.4}
      ],
      "maximumPoints": 24,
      "scoreCategoryId": "safety-compliance",
      "evaluationRules": [
        {"actionType": "select_disposition", "requiredPayload": {"disposition": "quarantine"}, "targetHasIssue": "packaging_damage", "outcomeType": "correct", "pointsAwarded": 4, "feedbackCode": "damage_quarantined", "correctActionLabel": "Quarantined damaged goods"},
        {"actionType": "select_disposition", "requiredPayload": {"disposition": "hold_for_verification"}, "targetHasIssue": "unreadable_barcode", "outcomeType": "correct", "pointsAwarded": 4, "feedbackCode": "barcode_held", "correctActionLabel": "Held unreadable-barcode goods for verification"},
        {"actionType": "select_disposition", "requiredPayload": {"disposition": "reject_return"}, "targetHasIssue": "incorrect_sku", "outcomeType": "correct", "pointsAwarded": 4, "feedbackCode": "incorrect_sku_rejected", "correctActionLabel": "Rejected the unauthorised SKU"},
        {"actionType": "select_disposition", "requiredPayload": {"disposition": "escalate"}, "targetHasIssue": "near_expiry", "outcomeType": "correct", "pointsAwarded": 4, "feedbackCode": "expiry_escalated", "correctActionLabel": "Escalated near-expiry stock for policy review", "missedIssueCode": "near_expiry"},
        {"actionType": "select_disposition", "requiredPayload": {"disposition": "hold_for_verification"}, "targetHasIssue": "quantity_shortage", "outcomeType": "correct", "pointsAwarded": 4, "feedbackCode": "shortage_held", "correctActionLabel": "Held the shortage record for reconciliation"},
        {"actionType": "select_disposition", "requiredPayload": {"disposition": "accept"}, "targetMustBeCompliant": true, "outcomeType": "correct", "pointsAwarded": 4, "feedbackCode": "compliant_stock_accepted", "correctActionLabel": "Accepted compliant stock"}
      ]
    },
    {
      "id": "confirm-quarantine",
      "stageId": "exception-handling",
      "taskType": "move_item",
      "title": "Confirm Exception Separation",
      "instructions": "Confirm all problematic stock is separated.",
      "mandatory": true,
      "repeatable": false,
      "availableActions": ["confirm_action"],
      "targetResourceIds": ["quarantine-record"],
      "competencyMappings": [{"competencyId": "warehouse-compliance", "weight": 1.0}],
      "maximumPoints": 10,
      "scoreCategoryId": "process-accuracy",
      "evaluationRules": [{
        "actionType": "confirm_action",
        "requiredPayload": {"allExceptionsSeparated": true},
        "outcomeType": "correct",
        "pointsAwarded": 10,
        "feedbackCode": "exceptions_separated",
        "correctActionLabel": "Separated problematic goods"
      }]
    },
    {
      "id": "complete-discrepancy-report",
      "stageId": "receiving-decision",
      "taskType": "complete_form",
      "title": "Complete Discrepancy Report",
      "instructions": "Record every required exception and recommendation.",
      "mandatory": true,
      "repeatable": false,
      "availableActions": ["complete_form"],
      "targetResourceIds": ["receiving-discrepancy-report"],
      "competencyMappings": [
        {"competencyId": "document-verification", "weight": 0.4},
        {"competencyId": "receiving-decisions", "weight": 0.6}
      ],
      "maximumPoints": 15,
      "scoreCategoryId": "process-accuracy",
      "evaluationRules": [{
        "actionType": "complete_form",
        "requiredPayload": {"poNumber": "PO-2026-001", "shortageRecorded": true, "unauthorizedSkuRecorded": true, "damageRecorded": true, "barcodeIssueRecorded": true, "nearExpiryRecorded": true},
        "outcomeType": "correct",
        "pointsAwarded": 15,
        "feedbackCode": "discrepancy_report_completed",
        "correctActionLabel": "Completed the receiving discrepancy report",
        "missedIssueCode": "discrepancy_report"
      }]
    },
    {
      "id": "make-receiving-decision",
      "stageId": "receiving-decision",
      "taskType": "make_decision",
      "title": "Select Receiving Decision",
      "instructions": "Choose the safe outcome for compliant and exception stock.",
      "mandatory": true,
      "repeatable": false,
      "availableActions": ["make_decision"],
      "targetResourceIds": ["receiving-discrepancy-report"],
      "competencyMappings": [{"competencyId": "receiving-decisions", "weight": 1.0}],
      "maximumPoints": 15,
      "scoreCategoryId": "decision-quality",
      "evaluationRules": [{
        "actionType": "make_decision",
        "requiredPayload": {"decision": "partially_accept"},
        "outcomeType": "correct",
        "pointsAwarded": 15,
        "feedbackCode": "partial_acceptance_selected",
        "correctActionLabel": "Selected partial acceptance"
      }]
    },
    {
      "id": "notify-supervisor",
      "stageId": "shift-report",
      "taskType": "confirm_action",
      "title": "Notify Receiving Supervisor",
      "instructions": "Share facts, actions and outstanding risks.",
      "mandatory": true,
      "repeatable": false,
      "availableActions": ["confirm_action"],
      "targetResourceIds": ["supervisor-notification"],
      "competencyMappings": [{"competencyId": "receiving-decisions", "weight": 1.0}],
      "maximumPoints": 10,
      "scoreCategoryId": "process-accuracy",
      "evaluationRules": [{
        "actionType": "confirm_action",
        "requiredPayload": {"supervisorNotified": true, "auditTrailIncluded": true},
        "outcomeType": "correct",
        "pointsAwarded": 10,
        "feedbackCode": "supervisor_notified",
        "correctActionLabel": "Escalated the documented exceptions"
      }]
    }
  ],
