{
  "id": "process-batch-01",
  "version": "1.0.0",
  "packId": "logistics-foundation",
  "workplaceId": "central-distribution-centre",
  "departmentId": "processing",
  "processId": "batch-processing",
  "role": {
    "id": "warehouse-associate-trainee",
    "industry": "logistics_supply_chain",
    "title": "Warehouse Associate",
    "level": "trainee",
    "departmentIds": [
      "receiving",
      "put-away",
      "processing"
    ],
    "requiredCompetencies": [
      "hygiene-discipline",
      "pack-weight-control",
      "batch-traceability",
      "quality-exception-handling"
    ],
    "promotionTargetRoleId": "warehouse-associate-junior"
  },
  "title": "Process Incoming Batch",
  "difficulty": "intermediate",
  "estimatedDurationMinutes": 22,
  "missionType": "guided_shift",
  "briefing": {
    "supervisorTitle": "Processing Supervisor",
    "message": "Six batches have arrived from Put Away and need to move through hygiene, packing, weight and label checks before they're released to Dispatch. Confirm your own hygiene status honestly, then process every batch carefully.",
    "shiftName": "Morning Shift",
    "supplier": "Internal Handoff \u2014 Put Away Department",
    "purchaseOrderNumber": "PO-2026-006",
    "deliveryReference": "PROC-2026-006",
    "deliveryType": "Internal processing handoff",
    "responsibilities": [
      "Confirm your pre-shift hygiene status honestly",
      "Scan every batch onto the processing line",
      "Pack every batch and record its weight accurately",
      "Verify every batch's label and traceability code",
      "Complete the supervisor sample review",
      "Classify any exception and hold affected batches",
      "Complete the processing report and notify the supervisor"
    ],
    "workplaceRules": [
      "A real hygiene gap must always be reported, never confirmed as compliant.",
      "An off-weight batch must never be released without being held for verification.",
      "A batch missing its traceability code must never be accepted.",
      "A label mismatch must always be held, never waved through."
    ],
    "rulesVersion": "1.0.0"
  },
  "objectives": [
    "Confirm hygiene compliance honestly",
    "Scan, pack and weigh every batch accurately",
    "Verify every batch's label and traceability code",
    "Complete the supervisor sample review",
    "Classify any batch exception correctly",
    "Complete the processing report and decision"
  ],
  "startingWorkstationId": "processing-entry",
  "stages": [
    "hygiene-and-scan",
    "packing",
    "quality-and-sample",
    "processing-decision"
  ],
  "stageDefinitions": [
    {
      "id": "hygiene-and-scan",
      "missionId": "process-batch-01",
      "sequence": 1,
      "title": "Hygiene Check and Batch Scan",
      "workstationId": "processing-entry",
      "instructions": "Confirm your pre-shift hygiene status, then scan every batch onto the processing line.",
      "taskIds": [
        "confirm-hygiene-compliance",
        "scan-processing-batches"
      ],
      "completionMode": "all_mandatory_tasks"
    },
    {
      "id": "packing",
      "missionId": "process-batch-01",
      "sequence": 2,
      "title": "Pack and Weigh",
      "workstationId": "packing-station",
      "instructions": "Pack every batch, then record the weight shown on the scale accurately.",
      "taskIds": [
        "pack-batch-items",
        "record-batch-weight"
      ],
      "completionMode": "all_mandatory_tasks"
    },
    {
      "id": "quality-and-sample",
      "missionId": "process-batch-01",
      "sequence": 3,
      "title": "Label Check and Supervisor Sample",
      "workstationId": "quality-check",
      "instructions": "Verify every batch's label and traceability code, then complete the supervisor sample review.",
      "taskIds": [
        "verify-batch-labels",
        "supervisor-sample-check"
      ],
      "completionMode": "all_mandatory_tasks"
    },
    {
      "id": "processing-decision",
      "missionId": "process-batch-01",
      "sequence": 4,
      "title": "Complete Processing Batch",
      "workstationId": "processing-office",
      "instructions": "Classify every batch exception, complete the report, confirm the outcome, and notify the supervisor.",
      "taskIds": [
        "classify-batch-exceptions",
        "complete-processing-report",
        "make-processing-decision",
        "notify-supervisor"
      ],
      "completionMode": "correct_decision"
    }
  ],
  "taskDefinitions": [
    {
      "id": "confirm-hygiene-compliance",
      "stageId": "hygiene-and-scan",
      "taskType": "confirm_action",
      "title": "Confirm Pre-Shift Hygiene Compliance",
      "instructions": "Review the hygiene checklist and confirm your actual compliance status honestly.",
      "mandatory": true,
      "repeatable": false,
      "availableActions": [
        "confirm_action"
      ],
      "targetResourceIds": [
        "hygiene-checklist"
      ],
      "competencyMappings": [
        {
          "competencyId": "hygiene-discipline",
          "weight": 1.0
        }
      ],
      "maximumPoints": 15,
      "scoreCategoryId": "hygiene-compliance",
      "evaluationRules": [
        {
          "actionType": "confirm_action",
          "requiredPayload": {
            "compliant": false
          },
          "targetHasIssue": "hygiene_missed",
          "outcomeType": "correct",
          "pointsAwarded": 15,
          "feedbackCode": "hygiene_gap_reported",
          "correctActionLabel": "Reported the hygiene compliance gap honestly",
          "missedIssueCode": "hygiene_missed"
        },
        {
          "actionType": "confirm_action",
          "requiredPayload": {
            "compliant": true
          },
          "targetMustBeCompliant": true,
          "outcomeType": "correct",
          "pointsAwarded": 15,
          "feedbackCode": "hygiene_confirmed",
          "correctActionLabel": "Confirmed hygiene compliance"
        }
      ]
    },
    {
      "id": "scan-processing-batches",
      "stageId": "hygiene-and-scan",
      "taskType": "scan_barcode",
      "title": "Scan Every Batch onto the Line",
      "instructions": "Scan each batch to confirm it has entered the processing line.",
      "mandatory": true,
      "repeatable": true,
      "availableActions": [
        "scan_barcode"
      ],
      "targetResourceIds": [
        "proc-batch-001",
        "proc-batch-002",
        "proc-batch-003",
        "proc-batch-004",
        "proc-batch-005",
        "proc-batch-006"
      ],
      "competencyMappings": [
        {
          "competencyId": "batch-traceability",
          "weight": 1.0
        }
      ],
      "maximumPoints": 12,
      "scoreCategoryId": "scan-and-pack-accuracy",
      "evaluationRules": [
        {
          "actionType": "scan_barcode",
          "requiredPayload": {
            "scanStatus": "matched"
          },
          "outcomeType": "correct",
          "pointsAwarded": 2,
          "feedbackCode": "batch_scan_confirmed",
          "correctActionLabel": "Scanned the batch onto the line"
        }
      ]
    },
    {
      "id": "pack-batch-items",
      "stageId": "packing",
      "taskType": "move_item",
