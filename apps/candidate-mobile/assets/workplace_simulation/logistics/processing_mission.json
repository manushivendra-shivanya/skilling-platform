      "evaluationRules": [
        {
          "actionType": "move_item",
          "requiredPayload": {
            "packed": true
          },
          "outcomeType": "correct",
          "pointsAwarded": 2,
          "feedbackCode": "batch_packed",
          "correctActionLabel": "Packed the batch"
        }
      ]
    },
    {
      "id": "record-batch-weight",
      "stageId": "packing",
      "taskType": "count_quantity",
