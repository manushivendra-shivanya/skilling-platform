    {
      "id": "classify-batch-exceptions",
      "stageId": "processing-decision",
      "taskType": "select_disposition",
      "title": "Classify Every Batch Exception",
      "instructions": "Choose the correct disposition for every batch based on what was found.",
      "mandatory": true,
      "repeatable": true,
      "availableActions": [
        "select_disposition"
      ],
      "targetResourceIds": [
        "proc-batch-001",
        "proc-batch-002",
        "proc-batch-003",
        "proc-batch-004",
        "proc-batch-005",
        "proc-batch-006"
      ],
      "competencyMappings": [
        {
          "competencyId": "quality-exception-handling",
          "weight": 1.0
        }
      ],
      "maximumPoints": 24,
      "scoreCategoryId": "process-accuracy",
      "evaluationRules": [
        {
          "actionType": "select_disposition",
          "requiredPayload": {
            "disposition": "hold_for_verification"
          },
          "targetHasIssue": "wrong_weight",
          "outcomeType": "correct",
          "pointsAwarded": 4,
          "feedbackCode": "wrong_weight_held",
          "correctActionLabel": "Held the off-weight batch for verification",
          "missedIssueCode": "wrong_weight"
        },
        {
          "actionType": "select_disposition",
          "requiredPayload": {
            "disposition": "hold_for_verification"
          },
          "targetHasIssue": "missing_traceability",
          "outcomeType": "correct",
          "pointsAwarded": 4,
          "feedbackCode": "missing_traceability_held",
          "correctActionLabel": "Held the batch missing traceability",
          "missedIssueCode": "missing_traceability"
        },
        {
          "actionType": "select_disposition",
          "requiredPayload": {
            "disposition": "hold_for_verification"
          },
          "targetHasIssue": "label_mismatch",
          "outcomeType": "correct",
          "pointsAwarded": 4,
          "feedbackCode": "label_mismatch_held",
          "correctActionLabel": "Held the batch with a label mismatch",
          "missedIssueCode": "label_mismatch"
        },
        {
          "actionType": "select_disposition",
          "requiredPayload": {
            "disposition": "accept"
          },
          "targetMustBeCompliant": true,
          "outcomeType": "correct",
          "pointsAwarded": 4,
          "feedbackCode": "compliant_batch_accepted",
          "correctActionLabel": "Accepted the compliant batch"
        }
      ]
    },
    {
