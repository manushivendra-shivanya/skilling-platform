{
  "id": "central-distribution-centre",
  "packId": "logistics-foundation",
  "name": "Central Distribution Centre",
  "workplaceType": "warehouse",
  "description": "A regional warehouse receiving, storing and dispatching consumer products.",
  "departments": ["receiving", "put-away"],
  "operationalRules": [
    "All incoming shipments require document verification.",
    "Damaged goods cannot enter available inventory.",
    "Unverified goods must remain on hold.",
    "Quantity discrepancies must be recorded."
  ],
  "departmentDefinitions": [
    {
      "id": "receiving",
      "workplaceId": "central-distribution-centre",
      "name": "Receiving Department",
      "description": "Handles incoming goods and supplier deliveries.",
      "workstations": [
        "receiving-dock",
        "document-desk",
        "inspection-zone",
        "barcode-station",
        "quarantine-zone",
        "receiving-office"
      ],
      "processes": ["incoming-shipment-receipt"]
    },
    {
      "id": "put-away",
      "workplaceId": "central-distribution-centre",
      "name": "Put Away Department",
      "description": "Moves accepted stock from Receiving into the correct storage zones.",
      "workstations": [
        "staging-area",
        "location-planning",
        "transport-placement",
        "putaway-office"
      ],
      "processes": ["putaway-storage-allocation"]
    }
  ],
  "workstationDefinitions": [
    {
      "id": "receiving-dock",
      "departmentId": "receiving",
      "name": "Receiving Dock",
      "workstationType": "receiving",
      "description": "Confirm delivered cartons and quantities.",
      "icon": "receiving_dock",
      "position": {"x": 0.12, "y": 0.22},
      "capabilities": ["count_quantity", "inspect_item"],
      "unlockRequirements": [{"type": "task_completed", "referenceId": "verify-documents"}]
    },
    {
      "id": "document-desk",
      "departmentId": "receiving",
      "name": "Document Desk",
      "workstationType": "documents",
      "description": "Compare the purchase order and delivery note.",
      "icon": "document",
      "position": {"x": 0.12, "y": 0.74},
      "capabilities": ["read_document", "document_comparison"],
      "unlockRequirements": []
    },
    {
      "id": "inspection-zone",
      "departmentId": "receiving",
      "name": "Inspection Zone",
      "workstationType": "inspection",
      "description": "Inspect packaging, quantity, labels, batch and expiry.",
      "icon": "inspection",
      "position": {"x": 0.48, "y": 0.22},
      "capabilities": ["inspect_item", "record_damage", "check_expiry"],
      "unlockRequirements": [
        {"type": "task_completed", "referenceId": "confirm-delivery-identity"},
        {"type": "task_completed", "referenceId": "confirm-received-counts"}
      ]
    },
    {
      "id": "barcode-station",
      "departmentId": "receiving",
      "name": "Barcode Station",
      "workstationType": "barcode",
      "description": "Check whether every barcode is readable and authorised.",
      "icon": "barcode",
      "position": {"x": 0.48, "y": 0.74},
      "capabilities": ["scan_barcode"],
      "unlockRequirements": [{"type": "task_completed", "referenceId": "inspect-cartons"}]
    },
    {
      "id": "quarantine-zone",
      "departmentId": "receiving",
      "name": "Quarantine Zone",
      "workstationType": "quarantine",
      "description": "Separate non-compliant and unverified stock.",
      "icon": "quarantine",
      "position": {"x": 0.84, "y": 0.22},
      "capabilities": ["select_disposition", "move_item"],
      "unlockRequirements": [{"type": "task_completed", "referenceId": "scan-barcodes"}]
    },
    {
      "id": "receiving-office",
      "departmentId": "receiving",
      "name": "Receiving Office",
      "workstationType": "office",
      "description": "Complete the discrepancy report and receiving decision.",
      "icon": "office",
      "position": {"x": 0.84, "y": 0.74},
      "capabilities": ["complete_form", "make_decision", "confirm_action"],
      "unlockRequirements": [{"type": "task_completed", "referenceId": "assign-dispositions"}]
    },
    {
      "id": "staging-area",
      "departmentId": "put-away",
      "name": "Staging Area",
      "workstationType": "staging",
      "description": "Accepted stock from Receiving waits here for a storage assignment.",
      "icon": "staging",
      "position": {"x": 0.15, "y": 0.5},
      "capabilities": ["read_document"],
      "unlockRequirements": []
    },
    {
      "id": "location-planning",
      "departmentId": "put-away",
      "name": "Location Planning",
      "workstationType": "planning",
      "description": "Assign every item to its correct storage zone.",
      "icon": "planning",
      "position": {"x": 0.4, "y": 0.5},
      "capabilities": ["classify_issue"],
      "unlockRequirements": [{"type": "task_completed", "referenceId": "open-putaway-list"}]
    },
    {
      "id": "transport-placement",
      "departmentId": "put-away",
      "name": "Transport and Placement",
      "workstationType": "transport",
      "description": "Move and place every item, then scan to confirm.",
      "icon": "transport",
      "position": {"x": 0.65, "y": 0.5},
      "capabilities": ["move_item", "scan_barcode", "count_quantity"],
      "unlockRequirements": [{"type": "task_completed", "referenceId": "assign-storage-zone"}]
    },
    {
      "id": "putaway-office",
      "departmentId": "put-away",
      "name": "Putaway Office",
      "workstationType": "office",
      "description": "Complete the putaway report and notify the supervisor.",
      "icon": "office",
      "position": {"x": 0.9, "y": 0.5},
      "capabilities": ["complete_form", "make_decision", "confirm_action"],
      "unlockRequirements": [
        {"type": "task_completed", "referenceId": "scan-items-to-bins"},
        {"type": "task_completed", "referenceId": "confirm-quantities-placed"}
      ]
    }
  ]
}
