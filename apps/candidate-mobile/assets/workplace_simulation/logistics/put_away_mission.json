  "scenario": {
    "defaultSeed": 71204,
    "variationRules": [
      {"type": "assign_issue", "issue": "hazmat_item", "severity": "critical", "eligibleTargets": ["put-item-001", "put-item-002", "put-item-003", "put-item-004", "put-item-005", "put-item-006"], "count": 1},
      {"type": "assign_issue", "issue": "cold_chain_item", "severity": "major", "eligibleTargets": ["put-item-001", "put-item-002", "put-item-003", "put-item-004", "put-item-005", "put-item-006"], "count": 1},
      {"type": "assign_issue", "issue": "high_value_item", "severity": "major", "eligibleTargets": ["put-item-001", "put-item-002", "put-item-003", "put-item-004", "put-item-005", "put-item-006"], "count": 1},
      {"type": "assign_issue", "issue": "zone_at_capacity", "severity": "minor", "eligibleTargets": ["put-item-001", "put-item-002", "put-item-003", "put-item-004", "put-item-005", "put-item-006"], "count": 1}
    ]
  },
  "scoringRule": {
    "minimumScore": 70,
    "allMandatoryTasksRequired": true,
    "criticalErrorsAllowed": 0,
    "scoreCategories": [
      {"id": "location-accuracy", "weight": 0.30},
      {"id": "safe-handling", "weight": 0.20},
      {"id": "inventory-accuracy", "weight": 0.20},
      {"id": "process-accuracy", "weight": 0.15},
      {"id": "decision-quality", "weight": 0.15}
    ]
  },
  "criticalErrorRules": [
    {"id": "hazmat-in-standard-zone", "title": "Hazardous Item Misplaced", "description": "A hazardous item was stored outside the hazmat locker.", "severity": "critical", "trigger": {"actionType": "classify_issue", "requiredPayload": {"selectedZone": "standard-shelving"}, "targetHasIssue": "hazmat_item"}, "scorePenalty": 25, "preventsPassing": true, "feedback": "Hazardous items must always be stored in the hazmat locker."},
    {"id": "cold-chain-in-standard-zone", "title": "Cold-Chain Item Misplaced", "description": "A cold-chain item was stored outside cold storage, risking spoilage.", "severity": "critical", "trigger": {"actionType": "classify_issue", "requiredPayload": {"selectedZone": "standard-shelving"}, "targetHasIssue": "cold_chain_item"}, "scorePenalty": 25, "preventsPassing": true, "feedback": "Cold-chain items must always be stored in the cold-storage unit."},
    {"id": "false-quantity-placed", "title": "Recorded Incorrect Placed Quantity", "description": "The placed quantity was knowingly falsified.", "severity": "critical", "trigger": {"actionType": "count_quantity", "requiredPayload": {"knowinglyIncorrect": true}}, "scorePenalty": 20, "preventsPassing": true, "feedback": "Placed quantities must be recorded accurately."}
  ]
}
