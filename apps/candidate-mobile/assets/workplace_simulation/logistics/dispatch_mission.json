          "competencyId": "exception-escalation",
          "weight": 1.0
        }
      ],
      "maximumPoints": 10,
      "scoreCategoryId": "process-and-decision",
      "evaluationRules": [
        {
          "actionType": "confirm_action",
          "requiredPayload": {
            "supervisorNotified": true,
            "exceptionsIncluded": true
          },
          "outcomeType": "correct",
          "pointsAwarded": 10,
          "feedbackCode": "supervisor_notified",
          "correctActionLabel": "Notified the supervisor with exceptions included"
        }
      ]
    }
