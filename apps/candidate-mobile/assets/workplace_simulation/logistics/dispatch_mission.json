{
  "id": "dispatch-orders-01",
  "version": "1.0.0",
  "packId": "logistics-foundation",
  "workplaceId": "central-distribution-centre",
  "departmentId": "dispatch",
  "processId": "route-dispatch",
  "role": {
    "id": "warehouse-associate-trainee",
    "industry": "logistics_supply_chain",
    "title": "Warehouse Associate",
    "level": "trainee",
    "departmentIds": [
      "receiving",
      "put-away",
      "processing",
      "dispatch"
    ],
    "requiredCompetencies": [
      "route-verification",
      "scan-discipline",
      "loading-sequence-control",
      "exception-escalation",
      "route-settlement-control"
    ],
    "promotionTargetRoleId": "warehouse-associate-junior"
  },
  "title": "Dispatch Delivery Route",
  "difficulty": "intermediate",
  "estimatedDurationMinutes": 24,
  "missionType": "guided_shift",
  "briefing": {
    "supervisorTitle": "Dispatch Supervisor",
    "message": "Six crates across three routes need to be picked, staged, loaded and dispatched today. Check the vehicle before loading, load in sequence, and resolve every exception before the route closes.",
    "shiftName": "Morning Shift",
    "supplier": "Internal Handoff \u2014 Processing Department",
    "purchaseOrderNumber": "PO-2026-009",
    "deliveryReference": "DISP-2026-009",
    "deliveryType": "Internal dispatch handoff",
    "responsibilities": [
      "Scan every crate and flag anything on the wrong route",
      "Consolidate and stage every crate for its route",
      "Verify the vehicle reaches temperature before loading",
      "Load every crate in the correct sequence",
      "Scan the manifest at the gate before departure",
      "Classify any exception and escalate customer disputes",
      "Resolve any cash/crate mismatch before closing the route",
      "Complete the report and notify the supervisor"
    ],
    "workplaceRules": [
      "A wrong-route crate must never be loaded onto the wrong vehicle.",
      "A vehicle that hasn't reached the required temperature must never be loaded.",
      "A route must never be closed with an unresolved cash or crate mismatch.",
      "A customer shortage dispute must always be escalated, never ignored."
    ],
    "rulesVersion": "1.0.0"
  },
  "objectives": [
    "Scan and flag crates accurately",
    "Consolidate and stage every route",
    "Verify vehicle temperature before loading",
    "Load every crate in sequence",
    "Scan the manifest at the gate",
    "Classify exceptions and escalate disputes correctly",
    "Complete the route settlement report and decision"
  ],
  "startingWorkstationId": "picking-station",
  "stages": [
    "picking",
    "consolidation-and-staging",
    "vehicle-verification",
    "gate-and-exceptions"
  ],
  "stageDefinitions": [
    {
      "id": "picking",
      "missionId": "dispatch-orders-01",
      "sequence": 1,
      "title": "Pick Order Items",
      "workstationId": "picking-station",
      "instructions": "Scan every crate to confirm it belongs on today's routes.",
      "taskIds": [
        "pick-order-items"
      ],
      "completionMode": "all_mandatory_tasks"
    },
    {
      "id": "consolidation-and-staging",
      "missionId": "dispatch-orders-01",
      "sequence": 2,
      "title": "Consolidate and Stage",
      "workstationId": "consolidation-bay",
      "instructions": "Consolidate every crate into its route and stage it for loading.",
      "taskIds": [
        "consolidate-order-items",
        "stage-route-crates"
      ],
      "completionMode": "all_mandatory_tasks"
    },
    {
      "id": "vehicle-verification",
      "missionId": "dispatch-orders-01",
      "sequence": 3,
      "title": "Verify Vehicle and Load",
      "workstationId": "vehicle-check",
      "instructions": "Check the vehicle temperature before loading, then load every crate in sequence.",
      "taskIds": [
        "verify-vehicle-temperature",
        "confirm-load-sequence"
      ],
      "completionMode": "all_mandatory_tasks"
    },
    {
      "id": "gate-and-exceptions",
      "missionId": "dispatch-orders-01",
      "sequence": 4,
      "title": "Gate Check and Exceptions",
      "workstationId": "dispatch-gate",
      "instructions": "Scan the manifest at the gate, classify any exception, complete the report, and notify the supervisor.",
      "taskIds": [
        "final-gate-scan",
        "handle-dispatch-exceptions",
        "complete-dispatch-report",
        "make-dispatch-decision",
        "notify-supervisor"
      ],
      "completionMode": "correct_decision"
    }
  ],
  "taskDefinitions": [
    {
      "id": "pick-order-items",
      "stageId": "picking",
      "taskType": "scan_barcode",
      "title": "Scan Every Crate for Its Route",
      "instructions": "Scan each crate. Flag any crate on the wrong route and rescan any failed read rather than forcing it through.",
      "mandatory": true,
      "repeatable": true,
      "availableActions": [
        "scan_barcode"
      ],
      "targetResourceIds": [
        "dispatch-crate-001",
        "dispatch-crate-002",
        "dispatch-crate-003",
        "dispatch-crate-004",
        "dispatch-crate-005",
        "dispatch-crate-006"
      ],
      "competencyMappings": [
        {
          "competencyId": "scan-discipline",
          "weight": 1.0
        }
      ],
      "maximumPoints": 18,
      "scoreCategoryId": "picking-accuracy",
      "evaluationRules": [
        {
          "actionType": "scan_barcode",
          "requiredPayload": {
            "flagged": true
          },
          "targetHasIssue": "wrong_route",
          "outcomeType": "correct",
          "pointsAwarded": 3,
          "feedbackCode": "wrong_route_flagged",
          "correctActionLabel": "Flagged the wrong-route crate instead of picking it",
          "missedIssueCode": "wrong_route"
        },
        {
          "actionType": "scan_barcode",
          "requiredPayload": {
            "rescanned": true
          },
          "targetHasIssue": "failed_scan",
          "outcomeType": "correct",
          "pointsAwarded": 3,
          "feedbackCode": "failed_scan_rescanned",
          "correctActionLabel": "Rescanned the crate instead of forcing it through",
          "missedIssueCode": "failed_scan"
        },
        {
          "actionType": "scan_barcode",
          "requiredPayload": {
            "scanStatus": "matched"
          },
          "targetMustBeCompliant": true,
          "outcomeType": "correct",
          "pointsAwarded": 3,
          "feedbackCode": "crate_scan_confirmed",
          "correctActionLabel": "Scanned the crate for its route"
        }
      ]
    },
    {
      "id": "consolidate-order-items",
      "stageId": "consolidation-and-staging",
      "taskType": "move_item",
      "title": "Consolidate Every Crate",
      "instructions": "Group every crate with the rest of its route.",
      "mandatory": true,
      "repeatable": true,
      "availableActions": [
        "move_item"
      ],
      "targetResourceIds": [
        "dispatch-crate-001",
        "dispatch-crate-002",
        "dispatch-crate-003",
        "dispatch-crate-004",
        "dispatch-crate-005",
        "dispatch-crate-006"
      ],
      "competencyMappings": [
        {
          "competencyId": "loading-sequence-control",
          "weight": 1.0
        }
      ],
      "maximumPoints": 12,
      "scoreCategoryId": "consolidation-and-staging",
      "evaluationRules": [
        {
          "actionType": "move_item",
          "requiredPayload": {
            "consolidated": true
          },
          "outcomeType": "correct",
          "pointsAwarded": 2,
          "feedbackCode": "crate_consolidated",
          "correctActionLabel": "Consolidated the crate into its route"
        }
      ]
    },
    {
      "id": "stage-route-crates",
      "stageId": "consolidation-and-staging",
      "taskType": "confirm_action",
      "title": "Stage Every Crate for Loading",
      "instructions": "Confirm every crate is staged in its route lane, ready for loading.",
      "mandatory": true,
      "repeatable": true,
      "availableActions": [
        "confirm_action"
      ],
      "targetResourceIds": [
        "dispatch-crate-001",
        "dispatch-crate-002",
        "dispatch-crate-003",
        "dispatch-crate-004",
        "dispatch-crate-005",
        "dispatch-crate-006"
      ],
      "competencyMappings": [
        {
          "competencyId": "route-verification",
          "weight": 1.0
        }
      ],
      "maximumPoints": 12,
      "scoreCategoryId": "consolidation-and-staging",
      "evaluationRules": [
        {
          "actionType": "confirm_action",
          "requiredPayload": {
            "staged": true
          },
          "outcomeType": "correct",
          "pointsAwarded": 2,
          "feedbackCode": "crate_staged",
          "correctActionLabel": "Staged the crate for loading"
        }
      ]
    },
    {
      "id": "verify-vehicle-temperature",
      "stageId": "vehicle-verification",
      "taskType": "inspect_item",
      "title": "Verify Vehicle Temperature Before Loading",
      "instructions": "Record the vehicle's temperature reading. Hold the vehicle for a recheck if it hasn't reached the required temperature.",
      "mandatory": true,
      "repeatable": false,
      "availableActions": [
        "record_temperature_reading"
      ],
      "targetResourceIds": [
        "dispatch-vehicle"
      ],
      "competencyMappings": [
        {
          "competencyId": "route-verification",
          "weight": 1.0
        }
      ],
      "maximumPoints": 15,
      "scoreCategoryId": "vehicle-verification",
      "evaluationRules": [
        {
          "actionType": "record_temperature_reading",
          "requiredPayload": {
            "heldForRecheck": true
          },
          "targetHasIssue": "vehicle_temp_failure",
          "outcomeType": "correct",
          "pointsAwarded": 15,
          "feedbackCode": "vehicle_temp_held",
          "correctActionLabel": "Held the vehicle for a temperature recheck",
          "missedIssueCode": "vehicle_temp_failure"
        },
        {
          "actionType": "record_temperature_reading",
          "requiredPayload": {
            "heldForRecheck": false
          },
          "targetMustBeCompliant": true,
          "outcomeType": "correct",
          "pointsAwarded": 15,
          "feedbackCode": "vehicle_temp_confirmed",
          "correctActionLabel": "Confirmed the vehicle reached the required temperature"
        }
      ]
    },
    {
      "id": "confirm-load-sequence",
      "stageId": "vehicle-verification",
      "taskType": "move_item",
      "title": "Load Every Crate in Sequence",
      "instructions": "Load every crate into the vehicle in the correct route sequence.",
      "mandatory": true,
      "repeatable": true,
      "availableActions": [
        "move_item"
      ],
      "targetResourceIds": [
        "dispatch-crate-001",
        "dispatch-crate-002",
        "dispatch-crate-003",
        "dispatch-crate-004",
        "dispatch-crate-005",
        "dispatch-crate-006"
      ],
      "competencyMappings": [
        {
          "competencyId": "loading-sequence-control",
          "weight": 1.0
        }
      ],
      "maximumPoints": 18,
      "scoreCategoryId": "loading-sequence",
      "evaluationRules": [
        {
          "actionType": "move_item",
          "requiredPayload": {
            "loadedInSequence": true
          },
          "outcomeType": "correct",
          "pointsAwarded": 3,
          "feedbackCode": "crate_loaded_in_sequence",
          "correctActionLabel": "Loaded the crate in the correct sequence"
        }
      ]
    },
    {
      "id": "final-gate-scan",
      "stageId": "gate-and-exceptions",
      "taskType": "scan_barcode",
      "title": "Scan the Manifest at the Gate",
      "instructions": "Scan the dispatch manifest at the gate before the vehicle departs.",
      "mandatory": true,
      "repeatable": false,
      "availableActions": [
        "scan_barcode"
      ],
      "targetResourceIds": [
        "dispatch-manifest"
      ],
      "competencyMappings": [
        {
          "competencyId": "scan-discipline",
          "weight": 1.0
        }
      ],
      "maximumPoints": 10,
      "scoreCategoryId": "gate-and-exception-handling",
      "evaluationRules": [
        {
          "actionType": "scan_barcode",
          "requiredPayload": {
            "gateScanStatus": "matched"
          },
          "outcomeType": "correct",
          "pointsAwarded": 10,
          "feedbackCode": "gate_scan_confirmed",
          "correctActionLabel": "Scanned the manifest at the gate"
        }
      ]
    },
    {
      "id": "handle-dispatch-exceptions",
      "stageId": "gate-and-exceptions",
      "taskType": "select_disposition",
      "title": "Classify Every Crate Exception",
      "instructions": "Choose the correct disposition for every crate based on what was found.",
      "mandatory": true,
      "repeatable": true,
      "availableActions": [
        "select_disposition"
      ],
      "targetResourceIds": [
        "dispatch-crate-001",
        "dispatch-crate-002",
        "dispatch-crate-003",
        "dispatch-crate-004",
        "dispatch-crate-005",
        "dispatch-crate-006"
      ],
      "competencyMappings": [
        {
          "competencyId": "exception-escalation",
          "weight": 1.0
        }
      ],
      "maximumPoints": 18,
      "scoreCategoryId": "gate-and-exception-handling",
      "evaluationRules": [
        {
          "actionType": "select_disposition",
          "requiredPayload": {
            "disposition": "hold_for_verification"
          },
          "targetHasIssue": "wrong_route",
          "outcomeType": "correct",
          "pointsAwarded": 3,
          "feedbackCode": "wrong_route_held",
          "correctActionLabel": "Held the wrong-route crate instead of loading it",
          "missedIssueCode": "wrong_route"
        },
        {
          "actionType": "select_disposition",
          "requiredPayload": {
            "disposition": "hold_for_verification"
          },
          "targetHasIssue": "partial_hold",
          "outcomeType": "correct",
          "pointsAwarded": 3,
          "feedbackCode": "shortage_dispute_escalated",
          "correctActionLabel": "Escalated the customer shortage dispute instead of ignoring it",
          "missedIssueCode": "partial_hold"
        },
        {
          "actionType": "select_disposition",
          "requiredPayload": {
            "disposition": "accept"
          },
          "targetHasIssue": "failed_scan",
          "outcomeType": "correct",
          "pointsAwarded": 3,
          "feedbackCode": "failed_scan_crate_accepted",
          "correctActionLabel": "Accepted the crate after its scan was successfully retried"
        },
        {
          "actionType": "select_disposition",
          "requiredPayload": {
            "disposition": "accept"
          },
          "targetMustBeCompliant": true,
          "outcomeType": "correct",
          "pointsAwarded": 3,
          "feedbackCode": "compliant_crate_accepted",
          "correctActionLabel": "Accepted the compliant crate"
        }
      ]
    },
    {
      "id": "complete-dispatch-report",
      "stageId": "gate-and-exceptions",
      "taskType": "complete_form",
      "title": "Complete the Route Settlement Report",
      "instructions": "Record that every crate was loaded and resolve any cash or crate mismatch before closing the route.",
      "mandatory": true,
      "repeatable": false,
      "availableActions": [
        "complete_form"
      ],
      "targetResourceIds": [
        "dispatch-report"
      ],
      "competencyMappings": [
        {
          "competencyId": "route-settlement-control",
          "weight": 1.0
        }
      ],
      "maximumPoints": 15,
      "scoreCategoryId": "process-and-decision",
      "evaluationRules": [
        {
          "actionType": "complete_form",
          "requiredPayload": {
            "allCratesLoaded": true,
            "exceptionsRecorded": true,
            "mismatchResolved": true
          },
          "targetHasIssue": "route_close_exception",
          "outcomeType": "correct",
          "pointsAwarded": 15,
          "feedbackCode": "mismatch_resolved_before_close",
          "correctActionLabel": "Resolved the cash/crate mismatch before closing the route",
          "missedIssueCode": "route_close_exception"
        },
        {
          "actionType": "complete_form",
          "requiredPayload": {
            "allCratesLoaded": true,
            "exceptionsRecorded": true
          },
          "targetMustBeCompliant": true,
          "outcomeType": "correct",
          "pointsAwarded": 15,
          "feedbackCode": "dispatch_report_completed",
          "correctActionLabel": "Completed the route settlement report"
        }
      ]
    },
    {
      "id": "make-dispatch-decision",
      "stageId": "gate-and-exceptions",
      "taskType": "make_decision",
      "title": "Confirm Dispatch Outcome",
      "instructions": "Select the outcome that matches the completed dispatch and any exceptions.",
      "mandatory": true,
      "repeatable": false,
      "availableActions": [
        "make_decision"
      ],
      "targetResourceIds": [
        "dispatch-report"
      ],
      "competencyMappings": [
        {
          "competencyId": "route-settlement-control",
          "weight": 1.0
        }
      ],
      "maximumPoints": 15,
      "scoreCategoryId": "process-and-decision",
      "evaluationRules": [
        {
          "actionType": "make_decision",
          "requiredPayload": {
            "decision": "dispatch_complete"
          },
          "outcomeType": "correct",
          "pointsAwarded": 15,
          "feedbackCode": "dispatch_complete_selected",
          "correctActionLabel": "Confirmed dispatch complete"
        }
      ]
    },
    {
      "id": "notify-supervisor",
      "stageId": "gate-and-exceptions",
      "taskType": "confirm_action",
      "title": "Notify Warehouse Supervisor",
      "instructions": "Share facts, exceptions and outstanding risks with the supervisor.",
      "mandatory": true,
      "repeatable": false,
      "availableActions": [
