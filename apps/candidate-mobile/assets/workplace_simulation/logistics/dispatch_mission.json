      "id": "loaded-wrong-route-crate",
      "title": "Loaded a Wrong-Route Crate",
      "description": "A crate on the wrong route was accepted and loaded instead of held.",
      "severity": "critical",
      "trigger": {
        "actionType": "select_disposition",
        "targetHasIssue": "wrong_route",
        "selectedDisposition": "accept"
      },
      "scorePenalty": 25,
      "preventsPassing": true,
      "feedback": "A wrong-route crate must always be held, never loaded onto the wrong vehicle."
    },
    {
      "id": "skipped-vehicle-temp-precheck",
      "title": "Skipped the Vehicle Temperature Pre-Check",
      "description": "Loading proceeded despite the vehicle not reaching the required temperature.",
      "severity": "critical",
      "trigger": {
        "actionType": "record_temperature_reading",
        "requiredPayload": {
          "proceededWithoutHold": true
        },
        "targetHasIssue": "vehicle_temp_failure"
      },
      "scorePenalty": 25,
      "preventsPassing": true,
      "feedback": "A vehicle that hasn't reached the required temperature must never be loaded."
    },
    {
      "id": "closed-route-unresolved-mismatch",
      "title": "Closed the Route With an Unresolved Mismatch",
      "description": "The route was closed without resolving a cash or crate mismatch.",
      "severity": "critical",
      "trigger": {
        "actionType": "complete_form",
        "requiredPayload": {
          "mismatchResolved": false
        },
        "targetHasIssue": "route_close_exception"
      },
      "scorePenalty": 25,
      "preventsPassing": true,
      "feedback": "A route must never be closed with an unresolved cash or crate mismatch."
