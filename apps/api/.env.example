# Copy to .env and fill in real values. Never commit .env.
PORT=3000

# Server-side only. Bypasses row-level security -- never expose to a client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Leave unset (or anything other than "production") in local/staging so the
# internal-only dev harness at GET /v1/dev/employer-review and the manual
# job-sync trigger at POST /v1/dev/job-sync stay reachable. Deployed/
# production environments must set NODE_ENV=production, which 404s both.
NODE_ENV=

# --- Job Sourcing (Phase H) ---
# Each job source auto-syncs into public.jobs roughly every 30 days (kept
# infrequent since Jooble's free-tier key is capped at 500 total requests),
# and can be triggered on demand via POST /v1/dev/job-sync in
# non-production for an immediate fresh refresh. Any source left unset
# here simply syncs zero jobs -- nothing crashes.

# Adzuna: self-serve registration at https://developer.adzuna.com/
# You must create this account yourself -- Claude cannot register
# third-party accounts on your behalf.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble: self-serve API key request at https://jooble.org/api/about
# You must obtain this key yourself.
JOOBLE_API_KEY=

# Careerjet: API v4 uses HTTP Basic auth with this key as the username and
# an empty password. Self-serve signup at https://www.careerjet.com/partners/api/
# You must obtain this key yourself.
CAREERJET_API_KEY=

# Greenhouse and Lever job boards need no API key or account -- they are
# public endpoints, but only return jobs for companies listed in
# apps/api/src/integrations/job-sources/named-companies.config.ts (empty
# by default). Add real board tokens / company slugs there once you have
# a target employer list.

# --- AI Career Coach ---
# POST /v1/coach/message. Server-side only -- never call an AI provider
# directly from the mobile app (see docs/25's Phase J precedent and
# docs/27-ai-coach-plan.md). Whichever provider is selected by
# COACH_MODEL_PROVIDER but has no key set below degrades to a clean 503 on
# that one endpoint -- the rest of the API still boots and runs fine.

# "gemini" (default) or "anthropic". Lets the Claude Sonnet 5 provider
# below be built and tested now but only go live via this one env var.
COACH_MODEL_PROVIDER=gemini

# Gemini: self-serve API key at https://aistudio.google.com/apikey
# You must obtain this key yourself.
GEMINI_API_KEY=

# Anthropic (Claude Sonnet 5): configured for later use -- not the active
# provider unless COACH_MODEL_PROVIDER=anthropic. Self-serve API key at
# https://console.anthropic.com/settings/keys. You must obtain this key
# yourself.
ANTHROPIC_API_KEY=
