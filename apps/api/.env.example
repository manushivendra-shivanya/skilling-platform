# Copy to .env and fill in real values. Never commit .env.
PORT=3000

# Server-side only. Bypasses row-level security -- never expose to a client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Leave unset (or anything other than "production") in local/staging so the
# internal-only dev harness at GET /v1/dev/employer-review and the manual
# job-sync trigger at POST /v1/dev/job-sync stay reachable. Deployed/
# production environments must set NODE_ENV=production, which 404s both.
NODE_ENV=

# --- Job Sourcing (Phase H) ---
# Each job source syncs into public.jobs on a 6-hour schedule (and can be
# triggered on demand via POST /v1/dev/job-sync in non-production). Any
# source left unset here simply syncs zero jobs -- nothing crashes.

# Adzuna: self-serve registration at https://developer.adzuna.com/
# You must create this account yourself -- Claude cannot register
# third-party accounts on your behalf.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble: self-serve API key request at https://jooble.org/api/about
# You must obtain this key yourself.
JOOBLE_API_KEY=

# Careerjet: self-serve affiliate id at https://www.careerjet.com/partners/api/
# You must obtain this affiliate id yourself.
CAREERJET_AFFILIATE_ID=

# Greenhouse and Lever job boards need no API key or account -- they are
# public endpoints, but only return jobs for companies listed in
# apps/api/src/integrations/job-sources/named-companies.config.ts (empty
# by default). Add real board tokens / company slugs there once you have
# a target employer list.
