# Copy to .env and fill in real values. Never commit .env.
PORT=3000

# Server-side only. Bypasses row-level security -- never expose to a client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Leave unset (or anything other than "production") in local/staging so the
# internal-only dev harness at GET /v1/dev/employer-review stays reachable.
# Deployed/production environments must set NODE_ENV=production, which 404s
# that route.
NODE_ENV=
